# 向量模型（EMBEDDING_PROVIDER=api 时生效，默认复用上面的地址与密钥）
EMBEDDING_MODEL=sensenova-embedding
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# 分块与检索
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
MIN_SCORE=0.2
EMBED_BATCH_SIZE=16

# 上传限制
MAX_FILE_MB=20

# 管理页口令，留空则不校验
