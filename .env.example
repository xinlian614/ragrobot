# 对话模型（OpenAI 兼容协议）
OPENAI_BASE_URL=https://token.sensenova.cn/v1
OPENAI_API_KEY=sk-o8fVqCneQfeD4LHGXbc2kU4MH8BJVaHJ
CHAT_MODEL=sensenova-6.8-flash-lite

# 检索方式：bm25 = 内置关键词检索（无需向量接口），api = 调用向量模型接口
